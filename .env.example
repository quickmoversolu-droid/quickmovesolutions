# QuickMove Solutions — Environment Variables Template
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Security
AUTH_SECRET="replace-with-32-byte-secret"
APP_ENCRYPTION_KEY="replace-with-32-byte-encryption-key"
INITIAL_OWNER_EMAIL="quickmoversolu@gmail.com"
INITIAL_OWNER_PASSWORD=""

# 1. Primary Backend — InsForge (https://insforge.dev/)
INSFORGE_BASE_URL="https://quickmove.insforge.app"
INSFORGE_ANON_KEY=""
INSFORGE_SERVICE_KEY=""

# Database URL (fallback / direct connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickmove?schema=public"

# 2. Primary AI Gateway — OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=""
OPENROUTER_TEXT_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_IMAGE_MODEL="black-forest-labs/flux-1.1-pro"

# 3. Meta Graph API (Official Facebook & Instagram Publishing)
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/marketing/oauth/meta"

# 4. Email Notifications ("console" | "resend" | "smtp")
EMAIL_PROVIDER="console"
EMAIL_FROM="QuickMove Solutions <quickmoversolu@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="quickmoversolu@gmail.com"
RESEND_API_KEY=""
